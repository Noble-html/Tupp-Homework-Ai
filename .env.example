# V50 BACKEND-ONLY FIREBASE: these variables belong to your server/hosting provider.
# No VITE_FIREBASE_* variables, no Firebase Web SDK, and no firebase-config.json.
# Required: the Firebase project's Web API key, used only server-side for Email/Password Auth REST calls.
FIREBASE_AUTH_API_KEY=
# Optional project ID; service-account project_id usually supplies this.
FIREBASE_PROJECT_ID=tupp-homework-ai
# Required: service-account JSON for Firebase Admin SDK; never put into the frontend or source control.
FIREBASE_SERVICE_ACCOUNT_JSON=
# First-admin one-time secret (24+ chars). Keep in host environment only.
ADMIN_BOOTSTRAP_SECRET=
# Optional emergency recovery secret (32+ random chars). Use only if no active CAO remains.
ADMIN_RECOVERY_SECRET=
# Gemini inference secret, server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

